+usbaudioApp.prototype._umpPressCallback = function (ctrlObj, appData, params)
+{
+    log.info("_umpPressCallback called...", appData);
+    //Take no action if app has changed.
+    if(framework.getCurrentApp() === 'usbaudio')
+    {
+        switch (appData)
+        {
+            case "playpause":
+                framework.sendEventToMmui(this.uiaId, "PlayPausePress");
+                break;
+            case "shuffle":
+                framework.sendEventToMmui(this.uiaId, "RandomPlayPress");
+                break;
+            case "repeat":
+                framework.sendEventToMmui(this.uiaId, "RepeatPress");
+                break;
+            case "next":
+                framework.sendEventToMmui(this.uiaId, "ScanNextTrackPress");
+                break;
+            case "prev":
+                framework.sendEventToMmui(this.uiaId, "ScanPreviousTrackPress");
+                break;
+            default:
+                log.warn("usbaudio: Unrecognized ump button clicked");
+                break;
+        }
+    }
+};
+
+usbaudioApp.prototype._umpReleaseCallback = function (ctrlObj, appData, params)
+{
+    log.info("_umpReleaseCallback called...", appData);
+    //Take no action if app has changed.
+    if(framework.getCurrentApp() === 'usbaudio')
+    {
+        switch (appData)
+        {
+            case "playpause":
+                framework.sendEventToMmui(this.uiaId, "PlayPauseRelease");
+                break;
+            case "shuffle":
+                framework.sendEventToMmui(this.uiaId, "RandomPlayRelease");
+                break;
+            case "repeat":
+                framework.sendEventToMmui(this.uiaId, "RepeatRelease");
+                break;
+            case "next":
+                framework.sendEventToMmui(this.uiaId, "ScanNextTrackRelease");
+                break;
+            case "prev":
+                framework.sendEventToMmui(this.uiaId, "ScanPreviousTrackRelease");
+                break;
+            default:
+                log.warn("usbaudio: Unrecognized ump button clicked");
+                break;
+        }
+    }
+};
+
 framework.registerAppLoaded("usbaudio", null, true);
