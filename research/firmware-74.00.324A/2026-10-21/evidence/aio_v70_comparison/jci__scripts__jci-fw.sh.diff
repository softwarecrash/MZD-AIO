+wcpset()
+{
+    # Insert jump rule to wcp_packets
+    $IPTABLES -I INPUT 3 -i wlan0 -s 192.168.100.0/24 -j wcp_packets
+}
+
+wcpdelete()
+{
+    # Delete jump rule to wcp_packets
+    $IPTABLES -D INPUT -i wlan0 -s 192.168.100.0/24 -j wcp_packets
+}
