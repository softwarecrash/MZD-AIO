+systemApp.prototype._displayDeviceNameEntCarPlayMenu = function(EntCarPlayItem, isAvailable, name)
+{
+	log.info("_displayDeviceName_EntCarPlayMenu  EntCarPlayItem=" + EntCarPlayItem + ", isAvailable=" + isAvailable + ", deviceName=" + name);
+
+    if (isAvailable && typeof name === "string" && name.length > 0)
+    {
+        EntCarPlayItem.text1Id = "APDevice";
+        EntCarPlayItem.text1SubMap = { "device name": name };
+    }
+    else
+    {
+        EntCarPlayItem.text1Id = "CarPlay";
+        EntCarPlayItem.text1SubMap = null;
+    }
+
+    // Update the Entertainment context if it is currently displayed.
+    if (this._currentContext && this._currentContext.ctxtId === "Entertainment" && this._currentContextTemplate)
+    {
+        var list = this._currentContextTemplate.list2Ctrl;
+        for (var i = 0; i < list.dataList.items.length; ++i)
+        {
+            if (list.dataList.items[i].appData.appName === 'carplay' && list.dataList.items[i].appData.mmuiEvent === 'SelectCarPlayWifi')
+            {
+                list.dataList.items[i] = EntCarPlayItem;
+                list.updateItems(i, i);
+                break;
+            }
+        }
+    }
+    else
+    {
+        log.debug("context is not Entertainment. nothingto do.");
+    }
+};
