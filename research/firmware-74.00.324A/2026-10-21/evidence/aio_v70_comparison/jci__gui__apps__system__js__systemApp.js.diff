+systemApp.prototype._verifyCarPlayWifiIcon = function(audioSource, isPlaying, dataList)
+{
+    var carPlayWifiIndex = -1;
+
+    for (var i = 0; i < dataList.items.length; ++i)
+    {
+        if (this._isCarPlayWifiMenu(dataList.items[i]))
+        {
+            carPlayWifiIndex = i;
+            break;
+        }
+    }
+
+    log.debug("_verifyCarPlayWifiIcon() : Index of CarPlay Menu for Wifi : " + carPlayWifiIndex);
+
+    if (-1 === carPlayWifiIndex)
+    {
+        return; // CarPlay Menu for Wifi is NOT Exist. no need to verify.
+    }
+
+    // Need to Fix index of Speeker Icon
+    for (var i = 0; i < dataList.items.length; ++i)
+    {
+        if (((audioSource === "CarPlay") && (dataList.items[i].appData.audioSourceId === "CarPlay" || dataList.items[i].appData.audioSourceId === "CarPlayWifi")) ||
+            ((audioSource === "CarPlayWifi") && (dataList.items[i].appData.audioSourceId === audioSource)))
+        {
+            dataList.items[i].image1 = ""; // anyway, Remove speeker Icon from USB CarPlay menu.
+
+            if (isPlaying)
+            {
+                // Set Speeker Icon to Wifi CarPlay menu.
+                dataList.items[carPlayWifiIndex].image1 = "common/images/icons/IcnListEntNowPlaying_En.png";
+            }
+            else
+            {
+                // UnSet Speeker Icon to Wifi CarPlay menu.
+                dataList.items[carPlayWifiIndex].image1 = "";
+            }
+
+            log.info("_verifyCarPlayWifiIcon() : Speeker Icon of Wifi CarPlay menu = " + dataList.items[carPlayWifiIndex].image1);
+            break;
+        }
+    }
+
+};
+
